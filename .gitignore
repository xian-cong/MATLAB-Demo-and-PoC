# ─────────────────────────────────────────────────────────────
# AMD / Xilinx Vivado build output (regenerable from the .xpr)
# ─────────────────────────────────────────────────────────────
*.cache/
*.hw/
*.ioplanning/
*.ip_user_files/
*.runs/
*.sim/
*.gen/
.Xil/

# Vivado journals, logs, backups, checkpoints
*.jou
*.log
*.str
*.backup.*
*.dcp
*.pb
*.rpx
hs_err_pid*.log
hs_err_pid*.dmp
webtalk*.jou
webtalk*.log

# xsim (Vivado simulator) output
xsim.dir/
*.wdb
*.vcd
xvhdl.pb
xelab.pb
xsim.pb

# scratch Vivado build projects for the simplified LED design
MathWorks/hdl_prj/build_v2/
**/build_v*/

# ─────────────────────────────────────────────────────────────
# MATLAB / Simulink build output
# ─────────────────────────────────────────────────────────────
slprj/
sccprj/
codegen/
*.slxc
*.asv
*.autosave
*.mex*
*.slx.r*

# HDL Coder Vivado project (regenerable); keep the generated VHDL in hdl_prj/hdlsrc
MathWorks/hdl_prj/vivado_prj/
MathWorks/hdl_prj_ipcore/

# Keep the generated VHDL under hdlsrc, but drop the regenerable
# code-generation report viewer and status files (report is ~5 MB of JS/CSS).
**/hdlsrc/**/_htmllib/
**/hdlsrc/**/html/
**/hdlsrc/**/hdlcodegenstatus.*
**/hdlsrc/**/*_report.html

# HDL Coder generated model + highlight scripts (regenerable)
**/gm_*.slx
**/highlightLUTPipeliningDiagnostic.m
**/clearhighlighting.m

# ─────────────────────────────────────────────────────────────
# OS / editor cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
flash_led_arty_guide_new.m