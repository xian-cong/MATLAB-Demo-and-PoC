# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y17 [get_cells u_ClockManager/txclk_BUFG_inst]
set_property LOC BUFGCTRL_X0Y18 [get_cells u_ClockManager/rxclk_BUFG_inst]
set_property LOC BUFGCTRL_X0Y16 [get_cells u_ClockManager/ETH_CLK25_OBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y20 [get_cells u_ClockManager/u_BUFG]
set_property LOC BUFGCTRL_X0Y19 [get_cells dutClk_BUFG_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y56 [get_cells ETH_CLK25_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X0Y72 [get_ports ETH_RXCLK]
set_property LOC IOB_X0Y74 [get_ports ETH_TXCLK]
set_property LOC IOB_X1Y76 [get_ports sysclk]

# Clock net "u_ClockManager/txclk_BUFG" driven by instance "u_ClockManager/txclk_BUFG_inst" located at site "BUFGCTRL_X0Y17"
#startgroup
create_pblock {CLKAG_u_ClockManager/txclk_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_u_ClockManager/txclk_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_ClockManager/txclk_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_u_ClockManager/txclk_BUFG}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "u_ClockManager/rxclk_BUFG" driven by instance "u_ClockManager/rxclk_BUFG_inst" located at site "BUFGCTRL_X0Y18"
#startgroup
create_pblock {CLKAG_u_ClockManager/rxclk_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_u_ClockManager/rxclk_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_ClockManager/rxclk_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_u_ClockManager/rxclk_BUFG}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "dutClk_BUFG" driven by instance "dutClk_BUFG_inst" located at site "BUFGCTRL_X0Y19"
#startgroup
create_pblock {CLKAG_dutClk_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_dutClk_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="dutClk_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_dutClk_BUFG}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup
